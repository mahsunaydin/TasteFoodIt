
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
@Html.Action("PartialHead", "Default")
<body>

    @Html.Action("PartialNavbarInfo", "Default")

    @Html.Action("PartialNavbar", "Default")
    <!-- END nav -->

    @Html.Action("PartialSlider", "Default")

    <section class="ftco-section ftco-wrap-about ftco-no-pb ftco-no-pt">
        <div class="container">
            <div class="row no-gutters">
                @Html.Action("PartialReservation", "Default")

                @Html.Action("PartialAbout", "Default")
            </div>
        </div>
    </section>

    <section class="ftco-section ftco-intro" style="background-image: url(/Templates/tasteit-master/images/bg_3.jpg);">
        <div class="overlay"></div>
        <div class="container">
            <div class="row">
                <div class="col-md-12 text-center">
                    <span>Hemen Yerinizi Ayırın</span>
                    <h2>Özel Buluşmalar &amp; Happy Hours</h2>
                </div>
            </div>
        </div>
    </section>

    @Html.Action("PartialMenu", "Default")

    @Html.Action("PartialTestimonial", "Default")

    @Html.Action("PartialChef", "Default")

    <section class="ftco-section ftco-no-pt ftco-no-pb">
        <div class="container">
            <div class="row d-flex">
                <div class="col-md-6 d-flex">
                    <div class="img img-2 w-100 mr-md-2" style="background-image: url(/Templates/tasteit-master/images/bg_6.jpg);"></div>
                    <div class="img img-2 w-100 ml-md-2" style="background-image: url(/Templates/tasteit-master/images/bg_4.jpg); "></div>
                </div>
                <div class="col-md-6 ftco-animate makereservation p-4 p-md-5">
                    <div class="heading-section ftco-animate mb-5">
                        <span class="subheading">Bizim Sırrımız</span>
                        <h2 class="mb-4">Kaliteyle Gelen Tat</h2>
                        <p>
                            Her gün mutfağımızda doğallığı ve lezzeti bir araya getiriyoruz.
                            Taze ürünler, ustalıkla hazırlanmış tarifler ve samimi bir atmosfer…
                            İşte bizi özel kılan sırlarımız.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="ftco-section ftco-no-pt ftco-no-pb ftco-intro bg-primary">
        <div class="container py-5">
            <div class="row py-2">
                <div class="col-md-12 text-center">
                    <h2>Gelenekten İlham, Modern Tatlar</h2>
                </div>
            </div>
        </div>
    </section>

    @Html.Action("PartialFooter","Default")

    @Html.Action("PartialScript", "Default")

</body>
</html>

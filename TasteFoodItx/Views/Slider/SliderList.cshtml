@model List<TasteFoodItx.Entities.Slider>

@{
    ViewBag.Title = "SliderList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid" id="container-wrapper">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Slider Listesi</h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="./">Ana Sayfa</a></li>
            <li class="breadcrumb-item">Slider</li>
            <li class="breadcrumb-item active" aria-current="page">Slider İşlemleri</li>
        </ol>
    </div>

    <div class="alert alert-primary">En fazla 4 adet slider eklenebilir. Sayı 4 olduğunda oluşturma butonu kaybolur.</div>

    <div class="row">
        <div class="col-lg-12 mb-4">
            <!-- Simple Tables -->
            <div class="card">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                </div>
                <div class="table-responsive">
                    <table class="table align-items-center table-flush">
                        <thead class="thead-light">
                            <tr>
                                <th>Slider ID</th>
                                <th>Başlık</th>
                                <th>Slogan</th>
                                <th>Alt Slogan</th>
                                <th>Görsel</th>
                                <th>Sil</th>
                                <th>Güncelle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td style="vertical-align:middle;">@item.SliderId</td>
                                    <td style="vertical-align:middle;">@item.Title</td>
                                    <td style="vertical-align:middle;">@item.Header</td>
                                    <td style="vertical-align:middle;">@item.Subheader</td>
                                    <td style="vertical-align:middle;"><img src="@item.ImageUrl" style="width:200px"></td>
                                    <td style="vertical-align:middle;"><a href="/Slider/DeleteSlider/@item.SliderId" class="btn btn-danger">Slider Sil</a></td>
                                    <td style="vertical-align:middle;"><a href="/Slider/UpdateSlider/@item.SliderId" class="btn btn-success">Slider Güncelle</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (ViewBag.v < 4)
                    {
                        <a href="/Slider/CreateSlider/" class="btn btn-primary">Yeni Slider Ekle</a>
                    }

                </div>
                <div class="card-footer"></div>
            </div>
        </div>
    </div>
</div>


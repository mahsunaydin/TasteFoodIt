
@{
    ViewBag.Title = "CreateAddress";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid" id="container-wrapper">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Adres Ekleme Sayfası</h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="./">Ana Sayfa</a></li>
            <li class="breadcrumb-item">Adresler</li>
            <li class="breadcrumb-item active" aria-current="page">Adres İşlemleri</li>
        </ol>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <!-- Form Basic -->
            <div class="card mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Adres Ekleme Paneli</h6>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="form-group">
                            <label for="exampleInputCategory">Telefon No</label>
                            <input type="text" name="Phone" class="form-control" id="exampleInputCategory" aria-describedby="emailHelp" placeholder="Telefon No Giriniz">
                            <br />
                            <label>Email Adresi</label>
                            <input type="email" name="Email" class="form-control" id="exampleInputCategory" aria-describedby="emailHelp" placeholder="Telefon No Giriniz">
                            <br />
                            <label>Gün Saat Tanımı</label>
                            <br />
                            <textarea name="Description" class="form-control"></textarea>
                            <br />
                        </div>
                        <button type="submit" class="btn btn-primary">Adresi Ekle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@model List<TasteFoodItx.Entities.Reservation>

@{
    ViewBag.Title = "ReservationList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid" id="container-wrapper">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Rezervasyon Listesi</h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="./">Ana Sayfa</a></li>
            <li class="breadcrumb-item">Rezervasyonlar</li>
            <li class="breadcrumb-item active" aria-current="page">Rezervasyon İşlemleri</li>
        </ol>
    </div>
    <div class="alert alert-primary">
        <a href="/Reservation/CreateReservation/" class="btn btn-primary">Yeni Rezervasyon Girişi</a>
    </div><br />

    <div class="row">
        <div class="col-lg-12 mb-4">
            <!-- Simple Tables -->
            <div class="card">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-flush">
                        <thead class="thead-light">
                            <tr>
                                <th>ID</th>
                                <th>Müşteri Adı</th>
                                <th>Email</th>
                                <th>Telefon</th>
                                <th>Rezervasyon Tarihi</th>
                                <th>Rezervasyon Saati</th>
                                <th>Misafir Sayısı</th>
                                <th>Rezervasyon Durumu</th>
                                <th>Durumu Değiştir</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ReservationId</td>
                                    <td>@item.Name</td>
                                    <td>@item.Email</td>
                                    <td>@item.Phone</td>
                                    <td>@item.ReservationDate.ToString("dd.MM.yyyy")</td>
                                    <td>@item.Time</td>
                                    <td>@item.GuestCount</td>
                                    @if (item.ReservationStatus == "Onaylandı")
                                    {
                                        <td><span class="badge badge-success">@item.ReservationStatus</span></td>
                                    }
                                    else if (item.ReservationStatus == "Bekliyor")
                                    {
                                        <td><span class="badge badge-warning">@item.ReservationStatus</span></td>
                                    }
                                    else if (item.ReservationStatus == "İptal")
                                    {
                                        <td><span class="badge badge-danger">@item.ReservationStatus</span></td>
                                    }
                                    <td style="white-space:nowrap; text-align:center;">
                                        <a href="/Reservation/ChangeStatusByWaiting/@item.ReservationId" class="btn btn-warning" style="display:inline-block; margin-right:5px;">Beklet</a>
                                        <a href="/Reservation/ChangeStatusByCancel/@item.ReservationId" class="btn btn-danger" style="display:inline-block; margin-right:5px;">İptal</a>
                                        <a href="/Reservation/ChangeStatusByApprove/@item.ReservationId" class="btn btn-success" style="display:inline-block;">Onayla</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer"></div>
            </div>
        </div>
    </div>
</div>

